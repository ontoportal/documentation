{
  "name": "just-the-docs",
  "version": "0.3.3",
  "description": "A modern Jekyll theme for documentation",
  "repository": "just-the-docs/just-the-docs",
  "license": "MIT",
  "bugs": "https://github.com/just-the-docs/just-the-docs/issues",
  "devDependencies": {
    "prettier": "^3.8.4",
    "stylelint": "^17.14.1",
    "stylelint-config-prettier-scss": "1.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-prettier": "^5.0.3"
  },
  "scripts": {
    "test": "stylelint '_sass/custom/**/*.scss' && node --check _includes/js/custom.js && node --check _includes/mermaid_config.js",
    "format": "prettier --write '**/*.{scss,js,json}'",
    "stylelint-check": "stylelint-config-prettier-check"
  }
}
